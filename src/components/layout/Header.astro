---
import { NAV_LINKS, SITE } from "../../data/constants";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-surface-200 bg-white/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href="/" class="text-xl font-bold tracking-tight text-brand-700">
      {SITE.name}
    </a>

    <ul class="hidden items-center gap-8 sm:flex">
      {NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm font-medium text-surface-600 transition-colors hover:text-brand-600"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="#contacto"
          class="rounded-full bg-brand-600 px-5 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
        >
          Cotizar
        </a>
      </li>
    </ul>

    <button
      id="menu-toggle"
      class="flex size-9 items-center justify-center rounded-lg border border-surface-300 sm:hidden"
      aria-label="Abrir menú"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="hidden border-t border-surface-200 bg-white px-4 pb-4 sm:hidden"
  >
    <ul class="flex flex-col gap-2 pt-2">
      {NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            class="block rounded-lg px-3 py-2 text-sm font-medium text-surface-600 transition-colors hover:bg-surface-100 hover:text-brand-600"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="#contacto"
          class="block rounded-full bg-brand-600 px-5 py-2 text-center text-sm font-semibold text-white transition-colors hover:bg-brand-700"
        >
          Cotizar
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
  }
</script>
