---
import Button from "../ui/Button.astro";
---

<section class="relative overflow-hidden bg-gradient-to-br from-surface-950 via-surface-900 to-brand-950">
  <div class="mx-auto max-w-7xl px-4 pb-32 pt-24 sm:px-6 lg:px-8 lg:pb-40 lg:pt-32">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
        El sonido que tu evento merece
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-surface-300 sm:text-xl">
        Arriendo de equipos de backline profesional para conciertos, eventos corporativos y grabaciones. Marcas premium, mantenimiento impecable, entrega puntual.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button href="/catalogo" size="lg">Ver catálogo</Button>
        <Button href="#contacto" variant="outline" size="lg">Solicitar cotización</Button>
      </div>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-surface-50 to-transparent" />
</section>
