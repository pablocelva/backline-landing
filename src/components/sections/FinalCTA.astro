---
import Button from "../ui/Button.astro";
---

<section class="bg-gradient-to-br from-brand-600 via-brand-700 to-brand-900 py-24">
  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
      ¿Listo para sonar profesional?
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-brand-100">
      Cuéntanos sobre tu evento y te enviaremos una cotización personalizada en menos de 2 horas.
    </p>
    <div class="mt-8">
      <Button href="#contacto" variant="secondary" size="lg">Habla con nosotros</Button>
    </div>
  </div>
</section>
