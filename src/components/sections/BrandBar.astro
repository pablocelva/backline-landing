---
import { marcas } from "../../data/marcas";
---

<section class="border-y border-surface-200 bg-white py-10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="mb-8 text-center text-sm font-medium text-surface-500">
      Trabajamos con las mejores marcas
    </p>
    <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
      {marcas.map((marca) => (
        <span class="text-lg font-bold text-surface-400 transition-colors hover:text-brand-600">
          {marca.nombre}
        </span>
      ))}
    </div>
  </div>
</section>
